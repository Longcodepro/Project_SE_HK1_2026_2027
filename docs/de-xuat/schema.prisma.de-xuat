generator client {
  provider      = "prisma-client-js"
  // alpine dùng musl + openssl 3 — phải khai báo để Prisma tải đúng engine
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Temperature {
  HOT
  COLD
}

enum PromotionScope {
  PUBLIC
  PERSONAL
}

enum RewardKind {
  POINTS
  CUPS
}

enum ProductStatus {
  ON_SALE
  SOLD_OUT
  LOCKED
}

enum OtpPurpose {
  REGISTER
  RESET_PASSWORD
}

enum NotificationEvent {
  ORDER_CREATED
  PAYMENT_SUCCESS
  ORDER_READY
  ORDER_COMPLETED
  REWARD_ISSUED
  WITHDRAWAL_COMPLETED
  WITHDRAWAL_REJECTED
}

enum NotificationChannel {
  SMS
  EMAIL
}

enum NotificationStatus {
  SENT
  FAILED
}

enum Role {
  CUSTOMER
  STAFF
  MANAGER
}

enum SizeCode {
  S
  M
  L
}

enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum CancelReason {
  CUSTOMER_CANCEL
  STAFF_CANCEL
}

enum PaymentMethod {
  EWALLET
  CARD
  TRANSFER
}

enum PaymentStatus {
  SUCCESS
  FAILED
}

enum RefundReason {
  CANCEL
  MISSING_ITEM
}

enum WalletTxType {
  REFUND_IN
  WITHDRAW_OUT
  WITHDRAW_RETURN
}

enum WithdrawalStatus {
  PENDING
  COMPLETED
  REJECTED
}

enum DestinationType {
  EWALLET
  CARD
  BANK
}

enum ItemResolution {
  REFUND_TO_WALLET
  EXCHANGE
}

enum DiscountType {
  PERCENT
  FIXED
  FREE_DRINK
}

model User {
  id Int @id @default(autoincrement())
  phone String @unique
  isPhoneVerified Boolean @default(false)
  email String? @unique
  passwordHash String
  fullName String
  role Role @default(CUSTOMER)
  isActive Boolean @default(true)
  loyaltyPoints Int @default(0)
  walletBalance Int @default(0)
  totalCups Int @default(0)
  createdAt DateTime @default(now())
  promotions Promotion[] @relation("Promotion_userId")
  orderByUserIds Order[] @relation("Order_userId")
  orderByCancelledByUserIds Order[] @relation("Order_cancelledByUserId")
  refunds Refund[] @relation("Refund_createdByUserId")
  walletTransactions WalletTransaction[] @relation("WalletTransaction_userId")
  withdrawalRequestByUserIds WithdrawalRequest[] @relation("WithdrawalRequest_userId")
  withdrawalRequestByHandledByUserIds WithdrawalRequest[] @relation("WithdrawalRequest_handledByUserId")
  itemIssues ItemIssue[] @relation("ItemIssue_handledByUserId")
  notifications Notification[] @relation("Notification_userId")
  revokedTokens RevokedToken[] @relation("RevokedToken_userId")
  promotionUsages PromotionUsage[] @relation("PromotionUsage_userId")
  serviceFeedbacks ServiceFeedback[] @relation("ServiceFeedback_userId")
  @@map("user")
}

model Category {
  id Int @id @default(autoincrement())
  name String @unique
  isVisible Boolean @default(true)
  products Product[] @relation("Product_categoryId")
  @@map("category")
}

model Product {
  id Int @id @default(autoincrement())
  categoryId Int
  category Category @relation("Product_categoryId", fields: [categoryId], references: [id])
  name String
  description String?
  imageUrl String?
  status ProductStatus @default(ON_SALE)
  allowHot Boolean @default(false)
  allowCold Boolean @default(true)
  defaultTemperature Temperature
  maxPerTopping Int
  maxToppingTotal Int
  dailyQuota Int @default(0)
  stockRemaining Int @default(0)
  stockDate DateTime?
  stockVersion Int @default(0)
  iceMin Int
  iceMax Int
  iceDefault Int
  sugarMin Int
  sugarMax Int
  sugarDefault Int
  productSizes ProductSize[] @relation("ProductSize_productId")
  productToppings ProductTopping[] @relation("ProductTopping_productId")
  orderItems OrderItem[] @relation("OrderItem_productId")
  promotionProducts PromotionProduct[] @relation("PromotionProduct_productId")
  rewardRuleProducts RewardRuleProduct[] @relation("RewardRuleProduct_productId")
  @@map("product")
}

model ProductSize {
  id Int @id @default(autoincrement())
  productId Int
  product Product @relation("ProductSize_productId", fields: [productId], references: [id], onDelete: Cascade)
  sizeCode SizeCode
  price Int
  volumeMl Int?
  @@map("product_size")
}

model Topping {
  id Int @id @default(autoincrement())
  name String @unique
  price Int
  isAvailable Boolean @default(true)
  productToppings ProductTopping[] @relation("ProductTopping_toppingId")
  orderItemToppings OrderItemTopping[] @relation("OrderItemTopping_toppingId")
  @@map("topping")
}

model ProductTopping {
  productId Int
  product Product @relation("ProductTopping_productId", fields: [productId], references: [id])
  toppingId Int
  topping Topping @relation("ProductTopping_toppingId", fields: [toppingId], references: [id])
  @@id([productId, toppingId])
  @@map("product_topping")
}

model Promotion {
  id Int @id @default(autoincrement())
  code String @unique
  scope PromotionScope
  userId Int
  user User @relation("Promotion_userId", fields: [userId], references: [id])
  ruleId Int
  rule RewardRule @relation("Promotion_ruleId", fields: [ruleId], references: [id])
  discountType DiscountType
  discountValue Int
  maxDiscountAmount Int
  minOrderAmount Int @default(0)
  maxTotalUses Int
  maxUsesPerUser Int @default(1)
  startsAt DateTime
  endsAt DateTime
  isActive Boolean @default(true)
  orders Order[] @relation("Order_promotionId")
  promotionUsages PromotionUsage[] @relation("PromotionUsage_promotionId")
  promotionProducts PromotionProduct[] @relation("PromotionProduct_promotionId")
  @@map("promotion")
}

model Order {
  id Int @id @default(autoincrement())
  orderCode String @unique
  userId Int
  user User @relation("Order_userId", fields: [userId], references: [id])
  promotionId Int?
  promotion Promotion? @relation("Order_promotionId", fields: [promotionId], references: [id])
  promotionCode String?
  status OrderStatus @default(PENDING)
  subtotal Int
  discountAmount Int @default(0)
  totalAmount Int
  pointsAwarded Int @default(0)
  pickupCode String? @unique
  cancelReason CancelReason?
  cancelledByUserId Int?
  cancelledByUser User? @relation("Order_cancelledByUserId", fields: [cancelledByUserId], references: [id])
  cancelNote String?
  createdAt DateTime
  updatedAt DateTime
  orderItems OrderItem[] @relation("OrderItem_orderId")
  payments Payment[] @relation("Payment_orderId")
  refunds Refund[] @relation("Refund_orderId")
  itemIssues ItemIssue[] @relation("ItemIssue_orderId")
  notifications Notification[] @relation("Notification_orderId")
  promotionUsage PromotionUsage? @relation("PromotionUsage_orderId")
  serviceFeedback ServiceFeedback? @relation("ServiceFeedback_orderId")
  @@map("order")
}

model OrderItem {
  id Int @id @default(autoincrement())
  orderId Int
  order Order @relation("OrderItem_orderId", fields: [orderId], references: [id])
  productId Int
  product Product @relation("OrderItem_productId", fields: [productId], references: [id])
  productName String
  sizeCode SizeCode
  sizeVolumeMl Int?
  unitPrice Int
  iceLevel Int
  sugarLevel Int
  temperature Temperature
  note String?
  quantity Int
  lineTotal Int
  orderItemToppings OrderItemTopping[] @relation("OrderItemTopping_orderItemId")
  itemIssues ItemIssue[] @relation("ItemIssue_orderItemId")
  @@map("order_item")
}

model OrderItemTopping {
  id Int @id @default(autoincrement())
  orderItemId Int
  orderItem OrderItem @relation("OrderItemTopping_orderItemId", fields: [orderItemId], references: [id])
  toppingId Int
  topping Topping @relation("OrderItemTopping_toppingId", fields: [toppingId], references: [id])
  toppingName String
  price Int
  quantity Int
  @@map("order_item_topping")
}

model Payment {
  id Int @id @default(autoincrement())
  orderId Int
  order Order @relation("Payment_orderId", fields: [orderId], references: [id])
  method PaymentMethod
  amount Int
  status PaymentStatus
  idempotencyKey String @unique
  gatewayRef String?
  cardLast4 String?
  transferRef String?
  expiresAt DateTime?
  createdAt DateTime
  refunds Refund[] @relation("Refund_paymentId")
  @@map("payment")
}

model Refund {
  id Int @id @default(autoincrement())
  orderId Int
  order Order @relation("Refund_orderId", fields: [orderId], references: [id])
  paymentId Int
  payment Payment @relation("Refund_paymentId", fields: [paymentId], references: [id])
  amount Int
  reason RefundReason
  createdByUserId Int
  createdByUser User @relation("Refund_createdByUserId", fields: [createdByUserId], references: [id])
  note String?
  createdAt DateTime
  walletTransactions WalletTransaction[] @relation("WalletTransaction_refundId")
  itemIssues ItemIssue[] @relation("ItemIssue_refundId")
  @@map("refund")
}

model WalletTransaction {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation("WalletTransaction_userId", fields: [userId], references: [id])
  type WalletTxType
  amount Int
  refundId Int?
  refund Refund? @relation("WalletTransaction_refundId", fields: [refundId], references: [id])
  withdrawalId Int?
  withdrawal WithdrawalRequest? @relation("WalletTransaction_withdrawalId", fields: [withdrawalId], references: [id])
  createdAt DateTime
  @@map("wallet_transaction")
}

model WithdrawalRequest {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation("WithdrawalRequest_userId", fields: [userId], references: [id])
  amount Int
  destinationType DestinationType
  accountName String
  accountNumber String
  bankName String?
  status WithdrawalStatus @default(PENDING)
  rejectReason String?
  transferRef String?
  handledByUserId Int?
  handledByUser User? @relation("WithdrawalRequest_handledByUserId", fields: [handledByUserId], references: [id])
  handledAt DateTime?
  createdAt DateTime
  walletTransactions WalletTransaction[] @relation("WalletTransaction_withdrawalId")
  @@map("withdrawal_request")
}

model ItemIssue {
  id Int @id @default(autoincrement())
  orderId Int
  order Order @relation("ItemIssue_orderId", fields: [orderId], references: [id])
  orderItemId Int
  orderItem OrderItem @relation("ItemIssue_orderItemId", fields: [orderItemId], references: [id])
  quantity Int
  resolution ItemResolution
  refundId Int?
  refund Refund? @relation("ItemIssue_refundId", fields: [refundId], references: [id])
  note String
  handledByUserId Int
  handledByUser User @relation("ItemIssue_handledByUserId", fields: [handledByUserId], references: [id])
  createdAt DateTime
  @@map("item_issue")
}

model OtpCode {
  id Int @id @default(autoincrement())
  phone String
  purpose OtpPurpose
  codeHash String
  expiresAt DateTime
  attempts Int @default(0)
  consumedAt DateTime?
  createdAt DateTime
  @@map("otp_code")
}

model Notification {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation("Notification_userId", fields: [userId], references: [id])
  orderId Int?
  order Order? @relation("Notification_orderId", fields: [orderId], references: [id])
  event NotificationEvent
  channel NotificationChannel
  recipient String
  content String
  status NotificationStatus
  createdAt DateTime
  @@map("notification")
}

model RevokedToken {
  id Int @id @default(autoincrement())
  jti String @unique
  userId Int
  user User @relation("RevokedToken_userId", fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime
  @@map("revoked_token")
}

model PromotionUsage {
  id Int @id @default(autoincrement())
  promotionId Int
  promotion Promotion @relation("PromotionUsage_promotionId", fields: [promotionId], references: [id])
  userId Int
  user User @relation("PromotionUsage_userId", fields: [userId], references: [id])
  orderId Int @unique
  order Order @relation("PromotionUsage_orderId", fields: [orderId], references: [id])
  createdAt DateTime
  releasedAt DateTime?
  @@map("promotion_usage")
}

model RewardRule {
  id Int @id @default(autoincrement())
  name String
  kind RewardKind
  threshold Int
  discountType DiscountType
  discountValue Int
  maxDiscountAmount Int
  minOrderAmount Int @default(0)
  validDays Int
  isActive Boolean @default(true)
  promotions Promotion[] @relation("Promotion_ruleId")
  rewardRuleProducts RewardRuleProduct[] @relation("RewardRuleProduct_ruleId")
  @@map("reward_rule")
}

model LoyaltySetting {
  id Int @id
  amountStep Int @default(10000)
  pointsPerStep Int @default(10)
  @@map("loyalty_setting")
}

model PromotionProduct {
  promotionId Int
  promotion Promotion @relation("PromotionProduct_promotionId", fields: [promotionId], references: [id])
  productId Int
  product Product @relation("PromotionProduct_productId", fields: [productId], references: [id])
  @@id([promotionId, productId])
  @@map("promotion_product")
}

model RewardRuleProduct {
  ruleId Int
  rule RewardRule @relation("RewardRuleProduct_ruleId", fields: [ruleId], references: [id])
  productId Int
  product Product @relation("RewardRuleProduct_productId", fields: [productId], references: [id])
  @@id([ruleId, productId])
  @@map("reward_rule_product")
}

model ServiceFeedback {
  id Int @id @default(autoincrement())
  orderId Int @unique
  order Order @relation("ServiceFeedback_orderId", fields: [orderId], references: [id])
  userId Int
  user User @relation("ServiceFeedback_userId", fields: [userId], references: [id])
  rating Int
  comment String?
  createdAt DateTime
  @@map("service_feedback")
}
