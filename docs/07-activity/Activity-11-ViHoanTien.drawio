<mxfile host="app.diagrams.net" pages="1"><diagram id="p0" name="Activity 11 — Ví hoàn tiền và rút tiền (UC71, UC72, UC73)"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Bắt đầu: khách&amp;#xa;có tiền hoàn&amp;#xa;trong ví" style="whiteSpace=wrap;html=1;fontSize=11;strokeColor=#333333;ellipse;fillColor=#E8F0FE;" vertex="1" parent="1"><mxGeometry x="239" y="30" width="80" height="44" as="geometry"/></mxCell><mxCell id="c3" value="UC71 WalletPage.load,&amp;#xa;WalletService.getWallet: xem số&amp;#xa;dư và lịch sử" style="whiteSpace=wrap;html=1;fontSize=11;strokeColor=#333333;rounded=1;arcSize=18;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="165" y="144" width="229" height="66" as="geometry"/></mxCell><mxCell id="c4" value="Muốn rút tiền?" style="whiteSpace=wrap;html=1;fontSize=11;strokeColor=#333333;rhombus;fillColor=#FFF4CC;" vertex="1" parent="1"><mxGeometry x="192" y="280" width="175" height="54" as="geometry"/></mxCell><mxCell id="c5" value="Kết thúc" style="whiteSpace=wrap;html=1;fontSize=11;strokeColor=#333333;ellipse;fillColor=#E8F0FE;" vertex="1" parent="1"><mxGeometry x="239" y="1644" width="80" height="44" as="geometry"/></mxCell><mxCell id="c6" value="UC72&amp;#xa;WalletPage.onRequestWithdrawal:&amp;#xa;số tiền, loại nhận, tên, số tài&amp;#xa;khoản, ngân hàng" style="whiteSpace=wrap;html=1;fontSize=11;strokeColor=#333333;rounded=1;arcSize=18;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="249" y="432" width="229" height="82" as="geometry"/></mxCell><mxCell id="c7" value="Hợp lệ? Từ 10.000&amp;#xa;đến số dư, đủ thông&amp;#xa;tin" style="whiteSpace=wrap;html=1;fontSize=11;strokeColor=#333333;rhombus;fillColor=#FFF4CC;" vertex="1" parent="1"><mxGeometry x="252" y="612" width="224" height="106" as="geometry"/></mxCell><mxCell id="c8" value="Wa