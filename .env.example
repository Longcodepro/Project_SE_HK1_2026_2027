# Sao chép file này thành .env rồi điền giá trị thật
# cp .env.example .env

# PostgreSQL — tài khoản và tên database, dùng cho cả Docker Compose và Prisma
# POSTGRES_USER: tên user đăng nhập PostgreSQL
POSTGRES_USER=your_db_user
# POSTGRES_PASSWORD: mật khẩu của user trên — đặt chuỗi khó đoán khi deploy
POSTGRES_PASSWORD=your_db_password
# POSTGRES_DB: tên database sẽ được tạo khi khởi động container lần đầu
POSTGRES_DB=your_db_name

# Connection string đầy đủ — phải khớp với POSTGRES_USER/PASSWORD/DB ở trên
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/your_db_name

# JWT — đổi thành chuỗi ngẫu nhiên dài trước khi deploy
JWT_SECRET=change-me-before-deploy-use-random-32-chars

# URL backend — frontend dùng biến này để gọi API
NEXT_PUBLIC_API_URL=http://localhost:3001
