# Sao chép file này thành .env rồi điền giá trị thật
# cp .env.example .env

# PostgreSQL — dùng khi chạy local (không Docker)
DATABASE_URL=postgresql://brewlite:brewlite_dev@localhost:5432/brewlite

# JWT — đổi thành chuỗi ngẫu nhiên dài trước khi deploy
JWT_SECRET=change-me-before-deploy-use-random-32-chars

# URL backend — frontend dùng biến này để gọi API
NEXT_PUBLIC_API_URL=http://localhost:3001
