{
  "info": {
    "name": "BrewLite API",
    "description": "Sinh tự động bằng `npm run postman:build` từ backend/postman/cases. Đừng sửa tay, hãy sửa file case rồi build lại.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 · Sức khỏe hệ thống",
      "item": [
        {
          "name": "Trang chủ API",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\nconst get = (o, p) => p === '' ? o : p.split('.').reduce((c, k) => (c == null ? undefined : c[k]), o);\nlet json; try { json = pm.response.json(); } catch (e) { json = undefined; }\n",
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"status\" + ' bằng ' + \"\\\"ok\\\"\", () => pm.expect(get(json, \"status\")).to.eql(\"ok\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [],
              "query": []
            }
          }
        },
