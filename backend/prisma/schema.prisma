generator client {
  provider      = "prisma-client-js"
  // alpine dùng musl + openssl 3 — phải khai báo để Prisma tải đúng engine
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id       String      @id
  name     String
  price    Int
  imageUrl String?
  stock    Int
  items    OrderItem[]
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now())
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  PAYMENT_FAILED
  CANCELLED
}

enum Size {
  S
  M
  L
}

model Topping {
  id    String @id
  name  String
  price Int
}

model Order {
  id        String      @id @default(uuid())
  userId    String
  status    OrderStatus @default(PENDING)
  total     Int
  createdAt DateTime    @default(now())
  items     OrderItem[]
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  size      Size
  qty       Int
  // Lưu id các topping đã chọn, giá topping đã cộng sẵn vào lineTotal
  toppings  String[] @default([])
  lineTotal Int
}
