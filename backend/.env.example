# Sao chép file này thành backend/.env rồi điền giá trị thật
# cp backend/.env.example backend/.env

# Prisma CLI đọc file này khi chạy migrate/seed từ thư mục backend/
# NestJS runtime đọc khi @nestjs/config được cấu hình (task 7)

# Connection string PostgreSQL — phải khớp với POSTGRES_USER/PASSWORD/DB trong root .env
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/your_db_name

# JWT secret — NestJS dùng để ký token (task 7), đổi trước khi deploy
JWT_SECRET=change-me-before-deploy-use-random-32-chars
